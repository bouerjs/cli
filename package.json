{
  "name": "bouer-cli",
  "version": "0.10.0",
  "description": "Command Line Interface (CLI) for bouerjs",
  "main": "index.js",
  "bin": {
    "bouer": "./index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "changelog": "auto-changelog -p -u",
    "start": "node index.js"
  },
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "template": "./templates/changelog-template.hbs",
    "unreleased": true,
    "commitLimit": false
  },
  "keywords": [
    "bouer",
    "bouer/cli",
    "bouer-cli",
    "cli"
  ],
  "preferGlobal": true,
  "author": {
    "name": "Joaquim Interesting",
    "email": "interestingjack0@gmail.com",
    "url": "https://github.com/JoaquimInteresting"
  },
  "contributors": [
    {
      "name": "Afonso Matumona",
      "email": "afonsomatumona@hotmail.com",
      "url": "https://www.github.com/afonsomatelias"
    },
    {
      "name": "Joaquim Interesting",
      "email": "interestingjack0@gmail.com",
      "url": "https://github.com/JoaquimInteresting"
    }
  ],
  "homepage": "https://bouerjs.github.io/cli/introduction.html",
  "repository": {
    "type": "git",
    "url": "git+bouerjs/cli.git"
  },
  "bugs": {
    "url": "https://github.com/bouerjs/cli/issues"
  },
  "dependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.26.0",
    "@types/node": "^22.13.5",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "auto-changelog": "^2.5.0",
    "babel-loader": "^9.2.1",
    "clean-webpack-plugin": "^4.0.0",
    "colors": "^1.4.0",
    "commander": "^13.1.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^9.21.0",
    "html-loader": "^5.1.0",
    "html-minimizer-webpack-plugin": "^6.0.0",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
